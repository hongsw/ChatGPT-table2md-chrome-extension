{
  "manifest_version": 3,
  "version": "0.0.5",
  "name": "ChatGPT Table-Mate",
  "description": "A Chrome extension to easily copy the table part of a ChatGPT response into markdown syntax and images",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["gtm.js", "content.styles.css", "icon.png", "icon.png"],
      "matches": []
    }
  ],
  "permissions": ["tabGroups", "notifications"],
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"]
    }
  ]
}
